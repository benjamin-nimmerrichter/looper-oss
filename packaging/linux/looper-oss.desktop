[Desktop Entry]
Type=Application
Name=Looper OSS
# filled in by build-appimage.sh; AppImageLauncher shows it in the menu name
X-AppImage-Version=@VERSION@
GenericName=Loop Station
Comment=Touchscreen loop station built on SuperCollider
Exec=AppRun
Icon=looper-oss
Terminal=false
Categories=AudioVideo;Audio;Music;X-Synthesis;
Keywords=looper;loop station;RC-505;sampler;live;
StartupNotify=true
StartupWMClass=looper-oss
